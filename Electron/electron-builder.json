{
  "asar": true,
  "directories": {
    "buildResources": "build",
    "output": "release/"
  },
  "extraResources" : [
    {
      "from": "AMAI-release",
      "filter": [
        "**/*"
      ],
      "to": "AMAI"
    },
    {
      "from": "../MPQEditor.exe",
      "to": "AMAI/MPQEditor.exe"
    }
  ],
  "files": [
    "**/*",
    "!**/*.ts",
    "!*.map",
    "!package.json",
    "!package-lock.json",
    {
      "from": "../dist",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      "portable"
    ]
  },
  "mac": {
    "icon": "dist/assets/icons",
    "target": [
      "dmg"
    ]
  },
  "linux": {
    "icon": "dist/assets/icons",
    "target": [
      "AppImage"
    ]
  }
}
