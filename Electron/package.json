{
  "name": "amai-installer",
  "version": "3.8.0",
  "description": "An installer for AMAI",
  "homepage": "https://github.com/SMUnlimited/AMAI",
  "keywords": [
    "AMAI",
    "wc3",
    "warcraft 3",
    "installer",
    "electron"
  ],
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "ng": "ng",
    "start": "cross-env ELECTRON_ENV=development npm-run-all -p electron:serve ng:serve",
    "ng:serve": "ng serve -c web -o",
    "build": "npm run electron:serve-tsc && ng build --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "web:build": "npm run build -- -c web-production",
    "electron": "electron",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && electron . --serve",
    "electron:local-dev": "npm run build:dev && electron .",
    "electron:local": "npm run build:prod && electron .",
    "electron:build": "cross-env PROD_ENV=production npm run build:prod && npm run only-electron:build && npm run package:release",
    "only-electron:build": "cross-env PROD_ENV=production electron-builder build --publish=never",
    "package:release": "node tools/package-release.js",
    "test:installer": "vitest run tests",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e": "npm run build:prod && playwright test -c e2e/playwright.config.ts e2e/",
    "e2e:test": "playwright test -c e2e/playwright.config.ts e2e/",
    "e2e:show-trace": "playwright show-trace e2e/tracing/trace.zip",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "lint": "ng lint angular-electron && ng lint angular-electron-e2e"
  },
  "dependencies": {
    "@angular/animations": "22.2.0",
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/language-service": "22.2.0",
    "@angular/material": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-browser-dynamic": "22.2.0",
    "@angular/router": "22.2.0",
    "@electron/remote": "2.1.3",
    "material-icons": "1.13.14",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@angular/localize": "22.2.0",
    "@codeandweb/http-loader": "16.0.0",
    "@codeandweb/ngx-translate": "16.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "7zip-bin": "5.2.0",
    "angular-eslint": "22.5.0",
    "conventional-changelog-cli": "5.0.0",
    "cross-env": "10.1.0",
    "electron": "22.3.27",
    "electron-builder": "26.15.3",
    "electron-reloader": "1.2.3",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "npm-run-all": "4.1.5",
    "playwright": "1.63.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.0.8",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ]
}
