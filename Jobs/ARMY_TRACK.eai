#IFDEF GLOBAL
    integer array army_owner
    location array army_loc
    location array army_dir
    location array army_future
    real array army_strength
    group array army_group
    integer array army_count
    integer army_num = 0
    real army_radius = 1500
    real army_future_mult = 3
    group in_army_group = CreateGroup()
    integer main_army = -1
    integer lastArmyNum = 0
    integer lastFreeNum = 0
    integer mode = 0
    integer most_threatened_player_town = -1
    integer next_most_threatened_player_town = -1
    integer next_most_threatened_town = -1
    integer next_most_threatened_enemy_town = -1
    location captain_home = null
    location defense_captain_home = null
    boolean captain_tp = true
    integer tmpmainarmy = -1
    integer town_threat_count = 0
#ELSE
// Army Tracker

function ClearTownIntrusion takes integer num returns nothing
  set town_intruder[num] = null
  set town_intruder_anchor[num] = null
  set town_intruder_owner[num] = null
  set town_intruder_since[num] = 0
  set town_intruder_seen[num] = 0
  set town_intruder_life[num] = 0
  set town_intruder_pressure[num] = 0
  set town_intruder_confirmed[num] = false
  set town_tower_progress[num] = false
endfunction

function CopyArmy takes integer from, integer to returns nothing
  set army_owner[to] = army_owner[from]
  set army_loc[to] = army_loc[from]
  set army_dir[to] = army_dir[from]
  set army_future[to] = army_future[from]
  set army_strength[to] = army_strength[from]
  set army_group[to] = army_group[from]
  set army_count[to] = army_count[from]
  set town_threat_army[to] = town_threat_army[from] //TODO Technically this is incorrect until job is processed as copy town does not handle this
  if main_army == from then
    set main_army = to
  endif
endfunction

// Helper: store a copy of a location for captain_home to avoid shared-handle invalidation
function SetCaptainHomeLoc takes location target returns nothing
  local location new_loc = null
  if target == null then
    return
  endif
  if captain_home != null and GetLocationX(captain_home) == GetLocationX(target) and GetLocationY(captain_home) == GetLocationY(target) then
    return
  endif
  call SetCaptainHome(ATTACK_CAPTAIN, GetLocationX(target), GetLocationY(target))
  set new_loc = Location(GetLocationX(target), GetLocationY(target))
  if captain_home != null then
    call RemoveLocation(captain_home)
  endif
  set captain_home = new_loc
endfunction

function SetDefenseCaptainHome takes location target returns nothing
  local location new_loc = null
  if target == null then
    return
  endif
  if defense_captain_home != null and GetLocationX(defense_captain_home) == GetLocationX(target) and GetLocationY(defense_captain_home) == GetLocationY(target) then
    return
  endif
  call SetCaptainHome(DEFENSE_CAPTAIN, GetLocationX(target), GetLocationY(target))
  set new_loc = Location(GetLocationX(target), GetLocationY(target))
  if defense_captain_home != null then
    call RemoveLocation(defense_captain_home)
  endif
  set defense_captain_home = new_loc
endfunction

// Share eligibility with seeding so rejected units do not start range scans.
function IsArmyUnit takes unit u, player owner returns boolean
  local integer order = 0
  if GetOwningPlayer(u) != owner or not UnitAlive(u) or IsUnitInGroup(u, in_army_group) or IsUnitType(u, UNIT_TYPE_STRUCTURE) or IsUnitType(u, UNIT_TYPE_PEON) or not IsStandardUnit(u) or IsUnitBuying(u) then
    return false
  endif
  set order = GetUnitCurrentOrder(u)
  return order != OrderId("harvest") and order != OrderId("resumeharvesting")
endfunction

function TrackArmy takes integer num returns boolean
  local group g = CreateGroup()
  local unit u = null
  local location l = null
  local player owner = Player(army_owner[num])
  local real x = 0
  local real y = 0
  local real strength = 0
  local integer count = 0
  local integer scanned = 0
  
  set u = FirstOfGroup(army_group[num])
  if u != null then
    // If tracking existing army select range from current position not historic position
    call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), army_radius, null)
  else
    call GroupEnumUnitsInRangeOfLoc(g, army_loc[num], army_radius, null)
  endif
  
  call GroupClear(army_group[num])
  
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if IsArmyUnit(u, owner) then
      if tmpmainarmy < 0 and u == major_hero then
        set tmpmainarmy = num // fallback main army
      endif
      call GroupAddUnit(army_group[num], u)
      call GroupAddUnit(in_army_group, u)
      set x = x + GetUnitX(u)
      set y = y + GetUnitY(u)
      set count = count + 1
      if (owner != ai_player and IsUnitInvisibleAM(u, ai_player))then
        // Fix using invisible units to exploit amai to force defend its town
      else
          set strength = strength + GetUnitStrength(u)
      endif
    endif
    call GroupRemoveUnit(g, u)
    set scanned = scanned + 1
    if ModuloInteger(scanned, 64) == 0 then
      call Sleep(0.01)
    endif
  endloop
  call DestroyGroup(g)
  set g = null
  set u = null
  set owner = null
  set army_count[num] = count
  set army_strength[num] = strength
  
  if army_count[num] == 0 or army_strength[num] == 0 then
    call DestroyGroup(army_group[num])
    set army_group[num] = null
    call RemoveLocation(army_loc[num])
    set army_loc[num] = null
    call RemoveLocation(army_dir[num])
    set army_dir[num] = null
    call RemoveLocation(army_future[num])
    set army_future[num] = null
    return false
  endif  
  
  call RemoveLocation(army_dir[num])
  set l = Location(x / I2R(count), y / I2R(count))
  set army_dir[num] = GetSubtractionLoc_kd(l, army_loc[num])
  if (Player(army_owner[num]) == ai_player) then 
    call CreateDebugTagLoc("Tracked Army: " + Int2Str(num) + " Strength:" + Int2Str(R2I(army_strength[num])), 10, GetLocationX(l), GetLocationY(l), 8.00, 3.00)
  endif  
  set army_loc[num] = Location(GetLocationX(l), GetLocationY(l))
  call RemoveLocation(army_future[num])
  call RemoveLocation(l)
  set l = GetSumLoc_kd(army_loc[num], GetMultipleLoc(army_dir[num], army_future_mult)) // This just sets a point in direction we want
  set army_future[num] = GetProjectedLoc(army_loc[num], l, GetRandomReal(full_threat_distance, no_threat_distance)) // Fixed location in direction army is going
  
 // if army_strength[num] != 0 then
   // call PingMinimap(GetLocationX(l), GetLocationY(l), 4)
 // endif
  call RemoveLocation(l)   
  set l = null
  
  return true
endfunction

function TrackExistingArmies takes nothing returns nothing
  local integer i = lastArmyNum
  local integer first_free = lastFreeNum
  set tmpmainarmy = -1
  loop
    exitwhen i >= army_num
    exitwhen i != lastArmyNum and ModuloInteger(i,30) == 0 // Resume after each batch of at most 30 armies
    if TrackArmy(i) then
      if (i != first_free) then
        call CopyArmy(i, first_free)
      endif
      set first_free = first_free + 1
    elseif main_army == i then
      set main_army = -1
    endif
    set i = i + 1
    if ModuloInteger(i, 8) == 0 then
      call Sleep(0.01)
    endif
  endloop
  if i >= army_num then
    set army_num = first_free
    set mode = 1
    set lastArmyNum = 0
    set lastFreeNum = 0
  else
    set lastFreeNum = first_free
    // This ensures list of armies are still partly usuable even though army track isn't quite finished
    // as the array is kept in sync with the army_num variable
    loop
      exitwhen i >= army_num
      call CopyArmy(i, first_free)
      set first_free = first_free + 1
      set i = i + 1
    endloop
    set lastArmyNum = lastFreeNum
    set army_num = first_free
    call TQAddJob(1, ARMY_TRACK, 0)
  endif
endfunction

function SeedNewArmyAtLoc takes location l, integer p returns nothing
  set army_owner[army_num] = p
  set army_loc[army_num] = l
  set army_dir[army_num] = Location(0,0)
  set army_future[army_num] = Location(0,0)
  set army_group[army_num] = CreateGroup()
  if TrackArmy(army_num) then
    set army_num = army_num + 1
  endif
endfunction

function SeedNewArmiesForPlayer takes integer p returns nothing
  local group g = CreateGroup()
  local unit u = null
  local integer i = 0
  local integer scanned = 0
  local integer seeded = 0
  local player owner = Player(p)
  call GroupEnumUnitsOfPlayer(g, owner, null)

  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if IsArmyUnit(u, owner) then
      call SeedNewArmyAtLoc(GetUnitLoc(u), p)
      set seeded = seeded + 1
      if ModuloInteger(seeded, 8) == 0 then
        call Sleep(0.01)
      endif
    endif
    call GroupRemoveUnit(g, u)
    set scanned = scanned + 1
    if ModuloInteger(scanned, 64) == 0 then
      call Sleep(0.01)
    endif
  endloop
  if Player(p) == ai_player then
    // Calculate main_army to be the largest group of units
    loop
      exitwhen i >= army_num
      if Player(army_owner[i]) == ai_player and (main_army < 0 or army_strength[main_army] < army_strength[i]) then
        set main_army = i
      endif
      set i = i + 1
      if ModuloInteger(i, 64) == 0 then
        call Sleep(0.01)
      endif
    endloop
  endif
  if main_army == -1 and tmpmainarmy >= 0 then
    set main_army = tmpmainarmy // backup incase cannot be calculated
  endif
  call DestroyGroup(g)
  set g = null
  set u = null
  set owner = null
endfunction

function SeedNewArmies takes nothing returns nothing
  local integer p = lastFreeNum
  loop
    exitwhen p >= GetBJMaxPlayers()
    exitwhen p != lastFreeNum and ModuloInteger(p, 10) == 0 // Sleep every 10 players
    if GetPlayerSlotState(Player(p)) == PLAYER_SLOT_STATE_PLAYING then
      call SeedNewArmiesForPlayer(p)
    endif
    set p = p + 1
  endloop
  if p >= GetBJMaxPlayers() then
    set mode = 2
    set lastFreeNum = 0
  else
    set lastFreeNum = p
    call TQAddJob(1, ARMY_TRACK, 0)
  endif
endfunction

// Live evaluation required as town tracking stops during town threatened
function GetLiveTownDefenseValue takes integer num returns integer
  local group g = CreateGroup()
  local unit u = null
  local integer value = 0
  local boolean has_expansion = false
  local integer scanned = 0
  set town_defense_anchor[num] = null
  call GroupEnumUnitsInRangeOfLoc(g, town_loc[num], town_radius, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if UnitAlive(u) and GetOwningPlayer(u) == Player(town_owner[num]) and IsUnitType(u, UNIT_TYPE_STRUCTURE) then
      if IsUnitType(u, UNIT_TYPE_TOWNHALL) or GetUnitTypeId(u) == old_id[racial_expansion] then
        if town_defense_anchor[num] == null or IsUnitType(u, UNIT_TYPE_TOWNHALL) then
          set town_defense_anchor[num] = u
        endif
        set has_expansion = true
        set value = value + 5
      else
        set value = value + 1
      endif
    endif
    call GroupRemoveUnit(g, u)
    set scanned = scanned + 1
    if ModuloInteger(scanned, 64) == 0 then
      call Sleep(0.01)
    endif
  endloop
  call DestroyGroup(g)
  set g = null
  set u = null
  if Player(town_owner[num]) == ai_player then
    if town_has_expansion[num] and not has_expansion then
      set town_destroyed_time[num] = TimerGetElapsed(tq_timer)
    endif
    set town_has_expansion[num] = has_expansion
  endif
  return value
endfunction

// A local candidate must threaten a live economy, not merely pass near a town.
function LocalIntrusionRank takes unit u, unit anchor returns integer
  local real dx = 0
  local real dy = 0
  local integer order = 0
  if u == null or anchor == null or not UnitAlive(u) or not UnitAlive(anchor) then
    return 0
  endif
  if not IsPlayerEnemy(GetOwningPlayer(anchor), GetOwningPlayer(u)) or not IsPlayerEnemy(ai_player, GetOwningPlayer(u)) or IsUnitHidden(u) or not IsUnitVisible(u, ai_player) or IsUnitInvisibleAM(u, ai_player) then
    return 0
  endif
  set dx = GetUnitX(u) - GetUnitX(anchor)
  set dy = GetUnitY(u) - GetUnitY(anchor)
  if dx * dx + dy * dy > full_threat_distance * full_threat_distance then
    return 0
  endif
  if IsUnitTower(u) then
    return 3
  endif
  if IsUnitType(u, UNIT_TYPE_ANCIENT) and IsUnitType(u, UNIT_TYPE_MELEE_ATTACKER) then
    return 2
  endif
  if IsUnitType(u, UNIT_TYPE_PEON) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and IsUnitType(u, UNIT_TYPE_ATTACKS_GROUND) then
    set order = GetUnitCurrentOrder(u)
    if order != OrderId("harvest") and order != OrderId("resumeharvesting") then
      return 1
    endif
  endif
  return 0
endfunction

function UpdateTownIntrusion takes integer num returns nothing
  local unit anchor = town_defense_anchor[num]
  local unit target = town_intruder[num]
  local unit u = null
  local group g = null
  local real now = TimerGetElapsed(tq_timer)
  local real strength = 0
  local real best_strength = -1
  local real distance = 0
  local real best_distance = 0
  local real dx = 0
  local real dy = 0
  local integer rank = 0
  local integer best_rank = 0
  local integer scanned = 0
  local boolean keep_target = false
  set town_intruder_pressure[num] = 0
  set town_tower_progress[num] = false
  if anchor == null then
    call ClearTownIntrusion(num)
    return
  endif
  if town_intruder_anchor[num] != anchor or now - town_intruder_seen[num] > 12 or LocalIntrusionRank(target, anchor) == 0 or GetOwningPlayer(target) != town_intruder_owner[num] then
    call ClearTownIntrusion(num)
    set target = null
  endif
  set keep_target = target != null
  set g = CreateGroup()
  call GroupEnumUnitsInRange(g, GetUnitX(anchor), GetUnitY(anchor), full_threat_distance, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    set rank = LocalIntrusionRank(u, anchor)
    if rank > 0 then
      set strength = GetUnitStrength(u)
      // Towers already contribute through the wider tower scan.
      if rank < 3 then
        set town_intruder_pressure[num] = town_intruder_pressure[num] + strength
      endif
      if not keep_target then
        set dx = GetUnitX(u) - GetUnitX(anchor)
        set dy = GetUnitY(u) - GetUnitY(anchor)
        set distance = dx * dx + dy * dy
        if rank > best_rank or (rank == best_rank and (strength > best_strength or (strength == best_strength and distance < best_distance))) then
          set target = u
          set best_rank = rank
          set best_strength = strength
          set best_distance = distance
        endif
      endif
    endif
    call GroupRemoveUnit(g, u)
    set scanned = scanned + 1
    if ModuloInteger(scanned, 64) == 0 then
      call Sleep(0.01)
    endif
  endloop
  call DestroyGroup(g)
  set g = null
  // Recheck after scan waits, before using the selected handle.
  if LocalIntrusionRank(target, anchor) == 0 or GetOwningPlayer(anchor) != Player(town_owner[num]) or (keep_target and GetOwningPlayer(target) != town_intruder_owner[num]) then
    call ClearTownIntrusion(num)
  else
    if not keep_target then
      set town_intruder[num] = target
      set town_intruder_anchor[num] = anchor
      set town_intruder_owner[num] = GetOwningPlayer(target)
      set town_intruder_since[num] = now
      set town_intruder_life[num] = GetUnitState(target, UNIT_STATE_LIFE)
    endif
    set town_intruder_seen[num] = now
    set town_intruder_confirmed[num] = now - town_intruder_since[num] >= 4
    set town_intruder_pressure[num] = town_intruder_pressure[num] * distance_threat_mult / Pow(full_threat_distance, distance_threat_exponent)
    set town_tower_progress[num] = town_intruder_confirmed[num] and IsUnitTower(target) and GetUnitState(target, UNIT_STATE_LIFE) >= GetUnitState(target, UNIT_STATE_MAX_LIFE) * 0.25 and GetUnitState(target, UNIT_STATE_LIFE) - town_intruder_life[num] >= GetUnitState(target, UNIT_STATE_MAX_LIFE) * 0.1
  endif
  set target = null
  set anchor = null
  set u = null
endfunction

function UpdateSpecificTownThreat takes integer num returns nothing
  local integer i = 0
  local real dist = 0
  local real threat = 0
  local real max_threat = 0
  local location loc = null
  local real x = 0
  local real y = 0
  local real dx = 0
  local real dy = 0
  local real current_dist = 0
  local real town_strength = 0
  local integer threat_army = -1
  if town_count[num] <= 0 or (IsPlayerAlly(Player(town_owner[num]), ai_player) and GetLiveTownDefenseValue(num) < 2) then
    set town_threat[num] = 0
    set town_threat_army[num] = -1
    call ClearTownIntrusion(num)
    set town_defense_anchor[num] = null
    return
  endif
  
  set x = GetLocationX(town_loc[num])
  set y = GetLocationY(town_loc[num])
  set loc = Location(0,0)
  set town_strength = GetLocationTowerStrength(x, y, ver_tower_check_radius) * 2 // Detect any tower rush events
  if IsPlayerAlly(Player(town_owner[num]), ai_player) then
    call UpdateTownIntrusion(num)
    if town_intruder_confirmed[num] then
      set town_strength = town_strength + town_intruder_pressure[num]
    endif
  endif
  loop
    exitwhen i >= army_num
    if army_owner[i] != town_owner[num] and Player(army_owner[i]) != ai_player then
      set dx = x - GetLocationX(army_future[i])
      set dy = y - GetLocationY(army_future[i])
      set dist = RMax(SquareRoot(dx * dx + dy * dy), full_threat_distance) // Future loc
      set dx = x - GetLocationX(army_loc[i])
      set dy = y - GetLocationY(army_loc[i])
      set current_dist = SquareRoot(dx * dx + dy * dy)
      call MoveLocation(loc, dx, dy)
      if current_dist < GetLengthOfLoc(army_dir[i]) and RAbs(GetAngleBetweenLocs(army_dir[i], loc)) <= 0.4 then // Current loc
        set dist = full_threat_distance
      else
        set dist = RMin(dist, current_dist)
      endif
      if dist <= no_threat_distance then
        //call DisplayToAll("Threat Dist:" + Real2Str(dist))
        //call DisplayToAll("Threat strength:" + Real2Str(army_strength[i]))
        //call DisplayToAll("Threat divisor:" + Real2Str(Pow(dist, distance_threat_exponent)))
        set threat = distance_threat_mult * army_strength[i] / Pow(dist, distance_threat_exponent)
        //call DisplayToAll("Threat:" + Real2Str(Pow(dist, distance_threat_exponent)))
        if IsPlayerAlly(Player(town_owner[num]), Player(army_owner[i])) and Player(army_owner[i]) != ai_player then
          set town_strength = town_strength - (threat*0.3) // Only ally units reduce threat so should protect own towns over allies, but in some situations ally units enough to protect town
        elseif Player(army_owner[i]) != ai_player then
          set town_strength = town_strength + threat
          if threat > max_threat then
            set max_threat = threat
            set threat_army = i
          endif
        endif
      endif
    endif
    set i = i + 1
    if ModuloInteger(i, 32) == 0 then
      call Sleep(0.01)
    endif
  endloop
  call RemoveLocation(loc)
  set loc = null
  set town_threat[num] = town_strength
  set town_threat_army[num] = threat_army
  if Player(town_owner[num]) == ai_player then
    if (next_most_threatened_player_town == -1 or town_threat[next_most_threatened_player_town] < town_threat[num]) and town_count[num] > 0 then
      set next_most_threatened_player_town = num
    endif
  elseif IsPlayerAlly(Player(town_owner[num]), ai_player) then
    if (next_most_threatened_town == -1 or town_threat[next_most_threatened_town] < town_threat[num]) and town_count[num] > 0 then
      if (town_can_tp[num] == true) then
        set next_most_threatened_town = num
      endif
    endif
   // call DisplayToAll("Town threatened "+Int2Str(num)+" Threat: "+Int2Str(R2I(town_threat[num])))
   // call PingMinimapEx(GetLocationX(town_loc[num]), GetLocationY(town_loc[num]), 4, 255, 0, 0, true)
  elseif IsPlayerEnemy(Player(town_owner[num]), ai_player) and town_count[num] > 0 then
    if next_most_threatened_enemy_town == -1 or town_threat[next_most_threatened_enemy_town] < town_threat[num] then
      set next_most_threatened_enemy_town = num
    endif
  endif
endfunction

function CanRecallToTown takes integer num, real threshold, real strength returns boolean
  if num < 0 or num >= town_num then
    return false
  endif
  return town_count[num] > 0 and town_threat[num] > 0 and town_threat[num] <= strength and (town_threat[num] > threshold or town_tower_progress[num])
endfunction

function UpdateTownThreat takes nothing returns nothing
  local integer i = 0
  local real accepted_threat_level = LinearInterpolation(atl_time_start, atl_time_end, atl_time_start_val, atl_time_end_val, TimerGetElapsed(tq_timer)) * LinearInterpolation(atl_enemy_start, atl_enemy_end, atl_enemy_start_mult, atl_enemy_end_mult, c_enemy_total)
  local real playerthreat = 0
  local integer enemy_army = -1
  local integer selected = -1
  local integer local_town = -1
  local integer previous_town = most_threatened_town
  local location defense_target = null
  local unit intruder = null
  local real dx = 0
  local real dy = 0
  if main_army >= 0 and main_army < army_num then
    set playerthreat = ApplyFleeStrengthModifier(distance_threat_mult * army_strength[main_army] / Pow(full_threat_distance, distance_threat_exponent), false)
  endif
  set next_most_threatened_player_town = -1
  set next_most_threatened_town = -1
  set next_most_threatened_enemy_town = -1
  loop
    exitwhen i >= town_num
    if i > 0 and ModuloInteger(i, 10) == 0 then
      call Sleep(0.01)
    endif
    call UpdateSpecificTownThreat(i)
    if IsPlayerAlly(Player(town_owner[i]), ai_player) and (Player(town_owner[i]) == ai_player or town_can_tp[i]) then
      if CanRecallToTown(i, accepted_threat_level * 1.05, playerthreat) or (Player(town_owner[i]) == ai_player and CanRecallToTown(i, accepted_threat_level, playerthreat)) then
        if selected < 0 or (Player(town_owner[i]) == ai_player and Player(town_owner[selected]) != ai_player) or (town_owner[i] == town_owner[selected] and town_threat[i] > town_threat[selected]) then
          set selected = i
        endif
      endif
    endif
    if town_intruder_confirmed[i] and (Player(town_owner[i]) == ai_player or (IsPlayerAlly(Player(town_owner[i]), ai_player) and town_can_tp[i])) then
      if local_town < 0 or (Player(town_owner[i]) == ai_player and Player(town_owner[local_town]) != ai_player) or (town_owner[i] == town_owner[local_town] and town_threat[i] > town_threat[local_town]) then
        set local_town = i
      endif
    endif
    set i = i + 1
  endloop
  set mode = 3
  set lastFreeNum = 0
  set most_threatened_player_town = next_most_threatened_player_town
  set most_threatened_town = next_most_threatened_town
  set most_threatened_enemy_town = next_most_threatened_enemy_town
  if selected >= 0 then
    set town_threatened = true
    set town_threat_count = 0
  elseif town_threatened and town_threat_count < 3 and previous_town >= 0 and previous_town < town_num and town_count[previous_town] > 0 and town_threat_army[previous_town] >= 0 and town_threat[previous_town] <= playerthreat then
    // Preserve army-defense persistence, without prolonging cancelled tower bait.
    set selected = previous_town
    set town_threat_count = town_threat_count + 1
  else
    set town_threatened = false
    // A minor intrusion must not redirect a fighting army's future retreat.
    if home_town >= 0 and home_town < town_num and town_count[home_town] > 0 then
      set selected = home_town
    endif
  endif
  if selected >= 0 then
    set most_threatened_town = selected
    call SetCaptainHomeLoc(town_loc[selected])
    set captain_tp = town_can_tp[selected]
  else
    call SetCaptainHomeLoc(home_location)
    set captain_tp = true
  endif
  set defense_target = captain_home
  if town_threatened and selected >= 0 then
    if town_intruder_confirmed[selected] then
      set local_town = selected
    endif
    set enemy_army = town_threat_army[selected]
    if enemy_army >= 0 and enemy_army < army_num and UnitAlive(town_defense_anchor[selected]) then
      set dx = GetLocationX(army_loc[enemy_army]) - GetUnitX(town_defense_anchor[selected])
      set dy = GetLocationY(army_loc[enemy_army]) - GetUnitY(town_defense_anchor[selected])
      if dx * dx + dy * dy <= full_threat_distance * full_threat_distance then
        set defense_target = army_loc[enemy_army]
      endif
    endif
  endif
  if local_town >= 0 and (not town_threatened or selected == local_town) then
    set intruder = town_intruder[local_town]
    if LocalIntrusionRank(intruder, town_defense_anchor[local_town]) > 0 then
      // Positioning local defenders does not interrupt the assault captain.
      set defense_target = GetUnitLoc(intruder)
      call SetDefenseCaptainHome(defense_target)
      call RemoveLocation(defense_target)
    else
      call SetDefenseCaptainHome(captain_home)
    endif
  else
    // Restore immediately on lost confidence: never chase a withdrawing scout.
    call SetDefenseCaptainHome(defense_target)
  endif
  set intruder = null
  set defense_target = null
endfunction

function ArmyTrackJob takes nothing returns nothing
  local unit alliance
  call DisplayToAllJobDebug("ARMY_TRACK JOB START")
  if (mode == 0) then
    call TrackExistingArmies()
  endif
  if (mode == 1) then
    call SeedNewArmies()
  endif
  if (mode == 2) then
    call UpdateTownThreat()
  endif
  if (mode == 3) then
    set mode = 0
    set tmpmainarmy = -1
    call GroupClear(in_army_group)
    call TQAddJob(4, TOWN_TRACK, 0)
  endif
endfunction
#ENDIF
