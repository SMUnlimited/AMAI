#IFDEF GLOBAL
    unit double_expansion_target = null
#ELSE
//============================================================================
// Detect multiple structures trying to claim the same mine.
//============================================================================
// Keep a full-health hall, otherwise use stable player/handle ordering so
// two unfinished foundations cannot each cancel the other.
function PreferExpansionClaimant takes unit candidate, unit existing returns boolean
  local boolean candidate_full = GetUnitState(candidate, UNIT_STATE_LIFE) >= GetUnitState(candidate, UNIT_STATE_MAX_LIFE)
  local boolean existing_full = GetUnitState(existing, UNIT_STATE_LIFE) >= GetUnitState(existing, UNIT_STATE_MAX_LIFE)
  if candidate_full != existing_full then
    return candidate_full
  endif
  if GetOwningPlayer(candidate) != GetOwningPlayer(existing) then
    return GetPlayerId(GetOwningPlayer(candidate)) < GetPlayerId(GetOwningPlayer(existing))
  endif
  return GetHandleId(candidate) < GetHandleId(existing)
endfunction

function CheckDoubleExpansion takes nothing returns nothing
  local group g = CreateGroup()
  local unit u = null
  local unit mine = null
  local unit claimant = null
  call GroupEnumUnitsOfPlayer(g, ai_player, null)
  set g = SelectNumberOfId(g, 100, old_id[racial_expansion])
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    set mine = GetNearestGoldMineToUnit(u)
    if mine != null then
      set claimant = GetExpansionMineClaimantEx(mine, u)
      if claimant != null and GetOwningPlayer(claimant) != ai_player then
        if IsPlayerAlly(ai_player, GetOwningPlayer(claimant)) then
          if GetUnitState(u, UNIT_STATE_LIFE) < GetUnitState(u, UNIT_STATE_MAX_LIFE) and PreferExpansionClaimant(claimant, u) then
            call IssueImmediateOrderById(u, order_cancel)
          endif
          call Trace("Ally claim detected on the same mine")
        else
          set double_expansion_target = claimant
          call Trace("Enemy claim detected on the same mine")
        endif
      elseif claimant != null and GetOwningPlayer(claimant) == ai_player and GetUnitState(u, UNIT_STATE_LIFE) < GetUnitState(u, UNIT_STATE_MAX_LIFE) and PreferExpansionClaimant(claimant, u) then
        call IssueImmediateOrderById(u, order_cancel)
        call Trace("Own duplicate claim detected on the same mine")
      endif
    endif
    call GroupRemoveUnit(g,u)
  endloop
  call DestroyGroup(g)
  set g = null
  set u = null
  set mine = null
  set claimant = null
endfunction

function DetectDoubleExpJob takes nothing returns nothing
  call DisplayToAllJobDebug("DETECT_DOUBLE JOB START")
  call CheckDoubleExpansion()
  call TQAddJob(10 * sleep_multiplier, DETECT_DOUBLE_EXP, 0)
endfunction
#ENDIF
