#IFDEF GLOBAL
  group windwalk_group = CreateGroup()
  group focus_fire_group = CreateGroup()
  group micro_ranged_group = CreateGroup()
  group micro_enemymelee_group = CreateGroup()
  location last_major_hero_loc = Location(0,0)
  real bj_PI = 3.14159
  real bj_RADTODEG = 180.0/bj_PI
#ELSE
// Keep captain control except while a Wind Walker attacks to break invisibility.
function CanFocusFireUnit takes unit u returns boolean
  local integer order = 0
  if u == null or GetUnitTypeId(u) == 0 or not UnitAlive(u) then
    return false
  endif
  if GetOwningPlayer(u) != ai_player or IsUnitHidden(u) or IsUnitLoaded(u) or IsUnitType(u, UNIT_TYPE_PEON) or IsUnitInGroup(u, windwalk_group) or not IsStandardUnit(u) or IsUnitBuying(u) then
    return false
  endif
  set order = GetUnitCurrentOrder(u)
  return order != OrderId("blizzard") and order != OrderId("flamestrike") and order != OrderId("massteleport") and order != OrderId("earthquake") and order != OrderId("voodoo") and order != OrderId("deathanddecay") and order != OrderId("starfall") and order != OrderId("tranquility") and order != OrderId("clusterrockets") and order != OrderId("tornado") and order != OrderId("volcano") and (order != OrderId("windwalk") or IsUnitInvisible(u, Player(PLAYER_NEUTRAL_AGGRESSIVE)))
endfunction

function IsFocusFireTarget takes unit u returns boolean
  if u == null or GetUnitTypeId(u) == 0 or not UnitAlive(u) then
    return false
  endif
  return IsPlayerEnemy(GetOwningPlayer(u), ai_player) and not IsUnitHidden(u) and IsUnitVisible(u, ai_player) and not IsUnitInvisibleAM(u, ai_player)
endfunction

function IsUnitFacingUnit takes unit u, unit target returns boolean
  local real angle = bj_RADTODEG * Atan2(GetUnitY(target) - GetUnitY(u), GetUnitX(target) - GetUnitX(u))
  return RAbs(ModuloReal(angle - GetUnitFacing(u) + 540, 360) - 180) <= 25
endfunction

// Search only nearby members of the current battle's melee group.
function GetNearestFocusMelee takes unit ranged, group meleeg, group nearby returns unit
  local unit candidate = null
  local unit nearest = null
  local real x = GetUnitX(ranged)
  local real y = GetUnitY(ranged)
  local real dx = 0
  local real dy = 0
  local real distance = 0
  local real nearest_distance = 200 * 200
  local integer i = 0
  call GroupEnumUnitsInRange(nearby, x, y, 200, null)
  loop
    set candidate = FirstOfGroup(nearby)
    exitwhen candidate == null
    if IsUnitInGroup(candidate, meleeg) and IsFocusFireTarget(candidate) then
      set dx = GetUnitX(candidate) - x
      set dy = GetUnitY(candidate) - y
      set distance = dx * dx + dy * dy
      if distance < nearest_distance then
        set nearest_distance = distance
        set nearest = candidate
      endif
    endif
    call GroupRemoveUnit(nearby, candidate)
    set i = i + 1
    if ModuloInteger(i, 64) == 0 then
      call Sleep(0.05)
    endif
  endloop
  set candidate = null
  return nearest
endfunction

function GroupMicroSystem takes group g, group meleeg, group focus_group returns nothing
  local unit u = null
  local unit melee = null
  local group nearby = CreateGroup()
  local real dx = 0
  local real dy = 0
  local real distance = 0
  local integer i = 0
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null or IsRetreatingAM() or (not attack_running and not town_threatened)
    set melee = null
    if not IsUnitInGroup(u, focus_fire_group) and CanFocusFireUnit(u) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
      set melee = GetNearestFocusMelee(u, meleeg, nearby)
    endif
    // The nearby search may yield. Recheck both units before reading positions.
    if CanFocusFireUnit(u) and IsFocusFireTarget(melee) and not IsRetreatingAM() and (attack_running or town_threatened) then
      set dx = GetUnitX(u) - GetUnitX(melee)
      set dy = GetUnitY(u) - GetUnitY(melee)
      set distance = SquareRoot(dx * dx + dy * dy)
      if distance > 0 and distance < 200 and IsUnitFacingUnit(melee, u) and GetUnitMoveSpeed(melee) <= GetUnitMoveSpeed(u) and (not IsUnitType(u, UNIT_TYPE_FLYING) or IsUnitType(melee, UNIT_TYPE_ATTACKS_FLYING)) then
        // Do not detach kiting units: an empty captain can end the whole attack.
        call IssuePointOrder(u, "move", GetUnitX(u) + dx * 800 / distance, GetUnitY(u) + dy * 800 / distance)
        call GroupRemoveUnit(focus_group, u)
        call GroupAddUnit(focus_fire_group, u)
      endif
    endif
    call GroupRemoveUnit(g, u)
    set i = i + 1
    if ModuloInteger(i, 32) == 0 then
      call Sleep(0.05)
    endif
  endloop
  call DestroyGroup(nearby)
  set nearby = null
  set u = null
  set melee = null
endfunction

// One enumeration replaces repeated whole-group filters and temporary copies.
function GetFocusFireUnits takes unit target returns group
  local group nearby = CreateGroup()
  local group selected = CreateGroup()
  local unit u = null
  local real dx = 0
  local real dy = 0
  local real distance = 0
  local integer i = 0
  if IsFocusFireTarget(target) then
    call GroupEnumUnitsInRange(nearby, GetUnitX(target), GetUnitY(target), RMax(normal_battle_radius, RMax(focus_fire_ranged_dist, focus_fire_melee_dist)), null)
    loop
      set u = FirstOfGroup(nearby)
      exitwhen u == null or not IsFocusFireTarget(target)
      if CanFocusFireUnit(u) and not IsUnitInGroup(u, focus_fire_group) and (not IsUnitType(target, UNIT_TYPE_FLYING) or IsUnitType(u, UNIT_TYPE_ATTACKS_FLYING)) then
        set dx = GetUnitX(u) - GetUnitX(target)
        set dy = GetUnitY(u) - GetUnitY(target)
        set distance = dx * dx + dy * dy
        if (IsUnitType(u, UNIT_TYPE_RANGED_ATTACKER) and distance <= focus_fire_ranged_dist * focus_fire_ranged_dist) or (IsUnitType(u, UNIT_TYPE_MELEE_ATTACKER) and distance <= focus_fire_melee_dist * focus_fire_melee_dist) or ((GetUnitAbilityLevel(u, 'AOwk') > 0 or GetUnitAbilityLevel(u, 'ANwk') > 0) and distance <= normal_battle_radius * normal_battle_radius) then
          call GroupAddUnit(selected, u)
        endif
      endif
      call GroupRemoveUnit(nearby, u)
      set i = i + 1
      if ModuloInteger(i, 64) == 0 then
        call Sleep(0.05)
      endif
    endloop
  endif
  call DestroyGroup(nearby)
  set nearby = null
  set u = null
  return selected
endfunction

// Borrow g from the caller; never replace or destroy it during filtering.
function FocusEnemyUnitsNearGroup takes group g returns unit
  local unit u = null
  local unit target = null
  local real hero_min_health = 100000
  local unit hero_min_health_unit = null
  local real min_health = 100000
  local unit min_health_unit = null
  local real building_min_health = 100000
  local unit building_min_health_unit = null
  local real disabled_min_health = 100000
  local unit disabled_min_health_unit = null
  local real range_strength = 0
  local integer i = 0
  local real unit_life = 0
  call GroupClear(micro_ranged_group)
  call GroupClear(micro_enemymelee_group)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if GetUnitTypeId(u) != 0 and UnitAlive(u) and not IsUnitHidden(u) then
      set unit_life = GetUnitState(u, UNIT_STATE_LIFE)
      if IsFocusFireTarget(u) and (not town_threatened or GetOwningPlayer(u) != Player(PLAYER_NEUTRAL_AGGRESSIVE)) then
        if IsUnitType(u, UNIT_TYPE_MELEE_ATTACKER) then
          call GroupAddUnit(micro_enemymelee_group, u)
        endif
        if IsUnitType(u, UNIT_TYPE_HERO) then
          if unit_life < hero_min_health then
            set hero_min_health = unit_life
            set hero_min_health_unit = u
          endif
        else
          if unit_life < min_health and not UnitIsSleeping(u) and (unit_life < GetUnitState(u, UNIT_STATE_MAX_LIFE) or IsUnitType(u, UNIT_TYPE_MELEE_ATTACKER) or IsUnitType(u, UNIT_TYPE_RANGED_ATTACKER) or IsUnitType(u, UNIT_TYPE_TOWNHALL)) then
            set min_health = unit_life
            set min_health_unit = u
          endif
          if unit_life < disabled_min_health and GetUnitMoveSpeed(u) == 0 and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not UnitIsSleeping(u) then
            set disabled_min_health = unit_life
            set disabled_min_health_unit = u
          endif
          if unit_life < building_min_health and IsUnitType(u, UNIT_TYPE_STRUCTURE) then
            set building_min_health = unit_life
            set building_min_health_unit = u
          endif
        endif
      elseif IsPlayerAlly(GetOwningPlayer(u), ai_player) and IsUnitType(u, UNIT_TYPE_RANGED_ATTACKER) then
        set range_strength = range_strength + GetUnitStrength(u)
        if unit_life < GetUnitState(u, UNIT_STATE_MAX_LIFE) and GetOwningPlayer(u) == ai_player then
          call GroupAddUnit(micro_ranged_group, u)
        endif
      endif
    endif
    call GroupRemoveUnit(g, u)
    set i = i + 1
    if ModuloInteger(i, 200) == 0 then
      call Sleep(0.05)
    endif
  endloop
  if hero_min_health_unit != null and (hero_min_health < focus_fire_limit * range_strength or disabled_min_health_unit == hero_min_health_unit) then
    call SetTargetHeroes(true)
    set target = hero_min_health_unit
  else
    call SetTargetHeroes(false)
    if disabled_min_health_unit != null then
      if min_health_unit != null and min_health * 3 < disabled_min_health then
        set target = min_health_unit
      else
        set target = disabled_min_health_unit
      endif
    elseif min_health_unit != null then
      set target = min_health_unit
    else
      set target = building_min_health_unit
    endif
  endif
  set u = null
  set hero_min_health_unit = null
  set min_health_unit = null
  set building_min_health_unit = null
  set disabled_min_health_unit = null
  return target
endfunction

// Scans return before issuing orders, keeping the native order call chain shallow.
function FocusBattleGroup takes group g returns nothing
  local unit target = FocusEnemyUnitsNearGroup(g)
  local unit u = null
  local group selected = null
  local integer i = 0
  local boolean windwalk_attack = false
  if not IsFocusFireTarget(target) or IsRetreatingAM() or (not attack_running and not town_threatened) then
    set target = null
    return
  endif
  set selected = GetFocusFireUnits(target)
  if FirstOfGroup(micro_enemymelee_group) != null and IsFocusFireTarget(target) then
    call GroupMicroSystem(micro_ranged_group, micro_enemymelee_group, selected)
  endif
  loop
    set u = FirstOfGroup(selected)
    exitwhen u == null or not IsFocusFireTarget(target) or IsRetreatingAM() or (not attack_running and not town_threatened)
    if CanFocusFireUnit(u) and not IsUnitInGroup(u, focus_fire_group) then
      if GetOwningPlayer(target) != Player(PLAYER_NEUTRAL_AGGRESSIVE) and not IsUnitType(target, UNIT_TYPE_STRUCTURE) and (GetUnitAbilityLevel(u, 'AOwk') > 0 or GetUnitAbilityLevel(u, 'ANwk') > 0) and not IsUnitInvisible(u, Player(PLAYER_NEUTRAL_AGGRESSIVE)) then
        call IssueImmediateOrder(u, "windwalk")
      else
        set windwalk_attack = (GetUnitAbilityLevel(u, 'AOwk') > 0 or GetUnitAbilityLevel(u, 'ANwk') > 0) and IsUnitInvisible(u, Player(PLAYER_NEUTRAL_AGGRESSIVE))
        if windwalk_attack then
          // Secure a return job before detaching; enqueueing can wait for the lock.
          if TQAddUnitJob(1.8, RESET_WINDWALKER, 0, u) then
            if CanFocusFireUnit(u) and IsFocusFireTarget(target) and not IsRetreatingAM() and (attack_running or town_threatened) then
              call GroupAddUnit(windwalk_group, u)
              call RemoveGuardPosition(u)
              call IssueTargetOrder(u, "attack", target)
            endif
          endif
        else
          call IssueTargetOrder(u, "attack", target)
        endif
      endif
      if GetUnitTypeId(u) != 0 then
        call GroupAddUnit(focus_fire_group, u)
      endif
    endif
    call GroupRemoveUnit(selected, u)
    set i = i + 1
    if ModuloInteger(i, 16) == 0 then
      call Sleep(0.05)
    endif
  endloop
  call DestroyGroup(selected)
  set selected = null
  set u = null
  set target = null
endfunction

function FocusFireJob takes nothing returns nothing
  local group g = null
  local integer i = 0
  call DisplayToAllJobDebug("FOCUSFIRE_CONTROL JOB START")
  call GroupClear(focus_fire_group)
  if not IsRetreatingAM() and (attack_running or town_threatened) then
    set g = CreateGroup()
    if major_hero == null or GetUnitTypeId(major_hero) == 0 or not UnitAlive(major_hero) or IsUnitInGroup(major_hero, unit_healing) then
      set major_hero = GetMajorHeroReplacement_k(major_hero, last_major_hero_loc)
    endif
    if major_hero != null and GetUnitTypeId(major_hero) != 0 and UnitAlive(major_hero) then
      call MoveLocation(last_major_hero_loc, GetUnitX(major_hero), GetUnitY(major_hero))
      call GroupEnumUnitsInRange(g, GetUnitX(major_hero), GetUnitY(major_hero), battle_radius, null)
      call FocusBattleGroup(g)
    endif
    if main_army >= 0 and main_army < army_num and army_loc[main_army] != null then
      call GroupEnumUnitsInRange(g, GetLocationX(army_loc[main_army]), GetLocationY(army_loc[main_army]), battle_radius, null)
      call FocusBattleGroup(g)
    endif
    loop
      exitwhen i >= army_num or IsRetreatingAM()
      if army_loc[i] != null and Player(army_owner[i]) == ai_player and main_army != i then
        call GroupEnumUnitsInRange(g, GetLocationX(army_loc[i]), GetLocationY(army_loc[i]), battle_radius, null)
        call FocusBattleGroup(g)
      endif
      set i = i + 1
    endloop
    call DestroyGroup(g)
    set g = null
  endif
  call GroupClear(micro_ranged_group)
  call GroupClear(micro_enemymelee_group)
  call SetTargetHeroes(difficulty != EASY)
  call TQAddJob(2 * sleep_multiplier, FOCUSFIRE_CONTROL, 0)
endfunction
#ENDIF
