#IFDEF GLOBAL
#ELSE
function GhoulReturnHomeJob takes unit u returns nothing
  if not IsUnitInGroup(u, returning_ghouls) then
    return
  endif
  if not UnitAlive(u) then
    call GroupRemoveUnit(returning_ghouls, u)
    return
  endif
  if DistanceBetweenPoints_dk(GetUnitLoc(u), home_location) > 800 then
    call IssuePointOrder(u, "move", GetLocationX(home_location), GetLocationY(home_location))
    call TQAddUnitJob(4, GHOUL_RETURN_HOME, 0, u)
    return
  endif
  call GroupRemoveUnit(returning_ghouls, u)
  call RecycleGuardPosition(u)
  call IssueImmediateOrder(u, "autoharvestlumber")
endfunction
#ENDIF
