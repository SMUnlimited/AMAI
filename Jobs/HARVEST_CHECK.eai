#IFDEF GLOBAL
  group harvest_mines = CreateGroup()
  integer harvest_mine_count = 0
  hashtable harvest_assignments = InitHashtable()
  group harvestgrp = CreateGroup() // Used to ensure we don't give harvest orders to peons multiple times
  group harvest_available_peons = CreateGroup()
  integer harvestnum = 0
#ELSE

function IsConstructionOrder takes integer order returns boolean
   return order > 852678
endfunction

function IsReservedHarvestPeon takes unit peon returns boolean
  local integer i = 1
  if peon == expansion_peon or peon == militia_builder or IsUnitInGroup(peon, early_remote_builders) then
    return true
  endif
  if race_militia_available and GetUnitAbilityLevel(peon, race_militia_ability) > 0 then
    return true
  endif
  if towerrush then
    loop
      exitwhen i > race_tower_peon
      if peon == builder[i] then
        return true
      endif
      set i = i + 1
    endloop
  endif
  return false
endfunction

// If not building anything and not doing special job functionality and not already ordered to harvest another mine
function IsPeonReadyToHarvest takes unit peon returns boolean
  return not IsReservedHarvestPeon(peon) and not IsConstructionOrder(GetUnitCurrentOrder(peon)) and GetUnitCurrentOrder(peon) != OrderId("repair") and IsStandardUnit(peon) and not IsUnitBuying(peon) and not IsUnitInGroup(peon, harvestgrp)
endfunction

function SelectByPeons takes group rg returns group
  local unit u = null
  local group g = rg
  set rg = CreateGroup()
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if ((race_manual_loading and GetUnitTypeId(u) == old_id[race_manual_loading_wisp]) or GetUnitTypeId(u) == old_id[racial_peon]) and UnitAlive(u) and IsPeonReadyToHarvest(u) then
      call GroupAddUnit(rg, u )
    endif
    call GroupRemoveUnit(g, u )
  endloop
  call DestroyGroup(g)
  set g = null
  return rg
endfunction

function SetPeonHarvestMine takes unit peon, unit mine returns nothing
  call SaveUnitHandle(harvest_assignments, 0, GetHandleId(peon), mine)
endfunction

function GetNearestHarvestMine takes unit peon, real maximumDistance returns unit
  local group g = CopyGroup(harvest_mines)
  local unit mine = null
  local unit nearest = null
  local real distance = 0
  local real nearestDistance = maximumDistance + 1
  loop
    set mine = FirstOfGroup(g)
    exitwhen mine == null
    set distance = DistanceBetweenUnits(peon, mine)
    if distance <= maximumDistance and (distance < nearestDistance or (distance == nearestDistance and (nearest == null or GetHandleId(mine) < GetHandleId(nearest)))) then
      set nearest = mine
      set nearestDistance = distance
    endif
    call GroupRemoveUnit(g, mine)
  endloop
  call DestroyGroup(g)
  set g = null
  set mine = null
  return nearest
endfunction

// Keep a small, stable gold roster. Unknown harvesters are only adopted while
// next to a mine, so lumber workers elsewhere cannot be mistaken for miners.
function RefreshHarvestPeons takes nothing returns nothing
  local unit u = null
  local unit assignedMine = null
  local integer order = 0
  local integer count = 0
  local group g = CreateGroup()
  call FlushChildHashtable(harvest_assignments, 1)
  call GroupClear(harvestgrp)
  call GroupClear(harvest_available_peons)
  if race_manual_loading then
    call FlushChildHashtable(harvest_assignments, 0)
    call DestroyGroup(g)
    set g = null
    return
  endif
  call GroupEnumUnitsOfPlayer(g, ai_player, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if racial_militia != 0 and GetUnitTypeId(u) == old_id[racial_militia] then
      call RemoveSavedHandle(harvest_assignments, 0, GetHandleId(u))
    elseif GetUnitTypeId(u) == old_id[racial_peon] then
      if not UnitAlive(u) then
        call RemoveSavedHandle(harvest_assignments, 0, GetHandleId(u))
      else
        set order = GetUnitCurrentOrder(u)
        set assignedMine = LoadUnitHandle(harvest_assignments, 0, GetHandleId(u))
        if assignedMine != null and (not UnitAlive(assignedMine) or GetResourceAmount(assignedMine) <= 0 or not IsUnitInGroup(assignedMine, harvest_mines) or (order != OrderId("harvest") and order != OrderId("resumeharvesting")) or not IsPeonReadyToHarvest(u)) then
          call RemoveSavedHandle(harvest_assignments, 0, GetHandleId(u))
          set assignedMine = null
        endif
        if assignedMine == null and order == OrderId("harvest") then
          set assignedMine = GetNearestHarvestMine(u, 225)
          if assignedMine != null then
            call SetPeonHarvestMine(u, assignedMine)
          endif
        endif
        if assignedMine != null then
          set count = LoadInteger(harvest_assignments, 1, GetHandleId(assignedMine)) + 1
          call SaveInteger(harvest_assignments, 1, GetHandleId(assignedMine), count)
          call GroupAddUnit(harvestgrp, u)
          // HarvestWood uses the same order id. Reassert only commuting Human/
          // Orc roster members; workers already beside the mine are untouched.
          if not race_uses_mine_expansion and order != OrderId("resumeharvesting") and DistanceBetweenUnits(u, assignedMine) > 225 then
            call IssueTargetOrder(u, "harvest", assignedMine)
          endif
        endif
        // A returning worker may be carrying lumber. Let it finish rather than
        // force-changing its target; it can be selected on the next pass.
        if order != OrderId("resumeharvesting") and IsPeonReadyToHarvest(u) then
          call GroupAddUnit(harvest_available_peons, u)
        endif
      endif
    endif
    call GroupRemoveUnit(g, u )
  endloop
  call DestroyGroup(g)
  set g = null
  set assignedMine = null
endfunction

function TakeNearestHarvestPeon takes unit mine returns unit
  local group g = CopyGroup(harvest_available_peons)
  local unit u = null
  local unit nearest = null
  local real distance = 0
  local real nearestDistance = 10000000
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    set distance = DistanceBetweenUnits(u, mine)
    if distance < nearestDistance or (distance == nearestDistance and (nearest == null or GetHandleId(u) < GetHandleId(nearest))) then
      set nearest = u
      set nearestDistance = distance
    endif
    call GroupRemoveUnit(g, u)
  endloop
  call DestroyGroup(g)
  if nearest != null then
    call GroupRemoveUnit(harvest_available_peons, nearest)
  endif
  set g = null
  return nearest
endfunction

function CountPeonsInMine takes unit mine returns integer
  return LoadInteger(harvest_assignments, 1, GetHandleId(mine))
endfunction

function PeonMineCheck takes unit mine returns boolean
  local group g = CreateGroup()
  local group tempg = null
  local location unitloc = GetUnitLoc(mine)
  local unit u = null
  local unit savewisp = null
  local integer i = 0
  local integer peon = TownCount(racial_peon)
  local integer peond = TownCountDone(racial_peon)
  local integer delaywisps = ver_optimal_gold - 1
  call DisplayToAllJobDebug("HARVEST CHECK Job Start")
  if peond > 5 then
    set delaywisps = ver_optimal_gold
  endif

  if race_manual_loading then
    call GroupEnumUnitsOfPlayer(g, ai_player, null)
    set g = SelectByPeons(g)
    set tempg = CreateGroup()
    loop
      set u = FirstOfGroup(g)
      exitwhen u == null
      if IsUnitInTransport(u, mine) then
        set savewisp = u
        set i = i + 1
        call SetPeonHarvestMine(u, mine)
        call GroupAddUnit(harvestgrp, u)
      else
        call GroupAddUnit(tempg, u)
      endif
      call GroupRemoveUnit(g, u)
    endloop
    call Trace("Already Harvesting:" + Int2Str(i))
    if FoodSpace() <= 0 and i >= 3 then  // no foodspace , no peon(at least keep 2 harvest mine) , need one harvest mine peon build Farms
      if peon == peond and peon <= 4 then
        set delaywisps = 2
        call IssueTargetOrder(mine, "unload", savewisp)
        call GroupRemoveUnit(harvestgrp, savewisp)
        call RemoveSavedHandle(harvest_assignments, 0, GetHandleId(savewisp))
      endif
    elseif peond < 7 and not hero_built[1] then
      set delaywisps = ver_optimal_gold - 2
    endif
    if i < delaywisps then
      call Trace("Correcting Harvest:" + Int2Str(delaywisps))
      set tempg = SelectByLoaded(tempg, false)
      //set tempg = SelectUnittype(tempg, UNIT_TYPE_STRUCTURE, false)  //  Preventing Tree Transformation
      set tempg = GetNearestSubGroupOfGroup(tempg, unitloc, delaywisps - i)
      //call GroupRemoveGuardPositionInstant(g) // this gets wisps to come off the trees.
      //call GroupTargetOrder(g, "harvest", mine)
      loop  //use accurate quantity control , prevent any wips harvestmine , but mine no vacancies
        set u = FirstOfGroup(tempg)
        exitwhen u == null or i >= delaywisps
        call IssueTargetOrder(u, "harvest", mine)
        call SetPeonHarvestMine(u, mine)
        call GroupAddUnit(harvestgrp, u)
        set i = i + 1
        call GroupRemoveUnit(tempg, u)
      endloop
    endif
    call DestroyGroup(tempg)
    set tempg = null
    set savewisp = null
  else //undead, human and orc
    set i = CountPeonsInMine(mine)
    call Trace("Already Harvesting:" + Int2Str(i))
    if i < delaywisps then
      call Trace("Correcting Harvest:" + Int2Str(delaywisps))
      loop
        set u = TakeNearestHarvestPeon(mine)
        exitwhen u == null or i >= delaywisps
        call IssueTargetOrder(u, "harvest", mine)
        call SetPeonHarvestMine(u, mine)
        call GroupAddUnit(harvestgrp, u)
        call SaveInteger(harvest_assignments, 1, GetHandleId(mine), i + 1)
        set i = i + 1
      endloop
    endif
  endif
  call RemoveLocation(unitloc)
  set unitloc = null
  call DestroyGroup(g)
  set g = null
  set u = null
  return i < delaywisps
endfunction

function RefreshHarvestMines takes nothing returns nothing
  local group g = null
  local group mines = null
  local unit u = null
  local unit mine = null
  local unit claimant = null
  call GroupClear(harvest_mines)
  set harvest_mine_count = 0
  set g = CreateGroup()
  if GetPlayerMineStyle(ai_player) == MINE_STYLE_SHARED then
    call GroupEnumUnitsOfPlayer(g, ai_player, null)
    loop
      set u = FirstOfGroup(g)
      exitwhen u == null
      if UnitAlive(u) and IsUnitType(u, UNIT_TYPE_TOWNHALL) then
        set mines = CreateGroup()
        call GroupEnumUnitsInRange(mines, GetUnitX(u), GetUnitY(u), race_max_expa_mine_distance, null)
        loop
          set mine = FirstOfGroup(mines)
          exitwhen mine == null
          if UnitAlive(mine) and GetResourceAmount(mine) > 0 and IsUnitGoldMine(mine) and not IsUnitInGroup(mine, harvest_mines) then
            set claimant = GetMineClaimant(mine)
            if claimant != null and GetOwningPlayer(claimant) == ai_player and IsUnitType(claimant, UNIT_TYPE_TOWNHALL) then
              call GroupAddUnit(harvest_mines, mine)
              set harvest_mine_count = harvest_mine_count + 1
            endif
          endif
          call GroupRemoveUnit(mines, mine)
        endloop
        call DestroyGroup(mines)
        set mines = null
      endif
      call GroupRemoveUnit(g, u)
    endloop
  else
    call GroupEnumUnitsOfPlayer(g, ai_player, null)
    loop
      set mine = FirstOfGroup(g)
      exitwhen mine == null
      if UnitAlive(mine) and GetResourceAmount(mine) > 0 and IsUnitGoldMine(mine) and not IsUnitInGroup(mine, harvest_mines) then
        call GroupAddUnit(harvest_mines, mine)
        set harvest_mine_count = harvest_mine_count + 1
      endif
      call GroupRemoveUnit(g, mine)
    endloop
  endif
  call DestroyGroup(g)
  set g = null
  set mines = null
  set u = null
  set mine = null
  set claimant = null
endfunction

function HarvestTrackedMines takes nothing returns boolean
  local group g = CreateGroup()
  local unit u = null
  local boolean mines_not_full = true
  call RefreshHarvestMines()
  call RefreshHarvestPeons()
  if TownThreatened() and home_town >= 0 and town_mine[home_town] != null and UnitAlive(town_mine[home_town]) then
    set mines_not_full = PeonMineCheck(town_mine[home_town])
    call DestroyGroup(g)
    set g = null
    return mines_not_full
  endif
  set g = CopyGroup(harvest_mines)
  if debugging == 1 then
    call Trace("Harvestable mines: " + Int2Str(harvest_mine_count))
  endif
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    set mines_not_full = PeonMineCheck(u) and mines_not_full
    call GroupRemoveUnit(g, u)
  endloop
  call DestroyGroup(g)
  set g = null
  return mines_not_full
endfunction

function ForcedHarvest takes nothing returns nothing
  local boolean mines_not_full = true
  if harvestnum == 0 then
    set mines_not_full = HarvestTrackedMines()
  endif
  if (harvestnum > 3 and mines_not_full) or harvestnum > 6 then
    set harvestnum = 0 
  else
    set harvestnum = harvestnum + 1
  endif
  return
endfunction

function HarvestCheckJob takes nothing returns nothing
  if HarvestTrackedMines() then
    call TQAddJob(4, HARVEST_CHECK, 0)
  else
    call TQAddJob(40, HARVEST_CHECK, 0)
  endif
endfunction
#ENDIF
