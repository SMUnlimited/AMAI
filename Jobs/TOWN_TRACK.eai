#IFDEF GLOBAL
    boolean town_threatened = false
    integer array town_owner
    location array town_loc
    real array town_value
    real array town_threat
    unit array town_defense_anchor
    unit array town_intruder
    unit array town_intruder_anchor
    player array town_intruder_owner
    real array town_intruder_since
    real array town_intruder_seen
    real array town_intruder_life
    real array town_intruder_pressure
    boolean array town_intruder_confirmed
    boolean array town_tower_progress
    integer array town_count
    boolean array town_has_expansion
    real array town_destroyed_time
    integer array town_threat_army
    boolean array town_can_tp
    real array town_dist
    unit array town_mine
    group array town_structures
    hashtable tracked_structures = InitHashtable()
    unit array town_builder
    integer array town_build_type
    integer array town_build_wait
    integer array town_build_item
    integer array town_build_count
    integer array town_build_progress
    real array town_build_distance
    integer most_threatened_town = -1
    integer most_threatened_enemy_town = -1
    integer max_value_town = -1
    integer home_town = -1
    integer town_num = 0
    real town_radius = 2500
    group in_town_group = CreateGroup()
    integer array own_town
    integer own_town_num = 0
    boolean home_found_temp = false
#ELSE
function CopyTown takes integer from, integer to returns nothing
  local group g = null
  local unit u = null
  if from == to then
    return
  endif
  set town_owner[to] = town_owner[from]
  set town_loc[to] = town_loc[from]
  set town_value[to] = town_value[from]
  set town_threat[to] = town_threat[from]
  set town_defense_anchor[to] = town_defense_anchor[from]
  set town_intruder[to] = town_intruder[from]
  set town_intruder_anchor[to] = town_intruder_anchor[from]
  set town_intruder_owner[to] = town_intruder_owner[from]
  set town_intruder_since[to] = town_intruder_since[from]
  set town_intruder_seen[to] = town_intruder_seen[from]
  set town_intruder_life[to] = town_intruder_life[from]
  set town_intruder_pressure[to] = town_intruder_pressure[from]
  set town_intruder_confirmed[to] = town_intruder_confirmed[from]
  set town_tower_progress[to] = town_tower_progress[from]
  set town_count[to] = town_count[from]
  set town_has_expansion[to] = town_has_expansion[from]
  set town_destroyed_time[to] = town_destroyed_time[from]
  set town_can_tp[to] = town_can_tp[from]
  set town_dist[to] = town_dist[from]
  set town_mine[to] = town_mine[from]
  if town_structures[to] != null then
    call DestroyGroup(town_structures[to])
  endif
  if town_structures[from] != null then
    set town_structures[to] = CopyGroup(town_structures[from])
    set g = CopyGroup(town_structures[to])
    loop
      set u = FirstOfGroup(g)
      exitwhen u == null
      call SaveInteger(tracked_structures, GetHandleId(u), 0, to + 1)
      call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = null
    set u = null
  else
    set town_structures[to] = null
  endif
  set town_builder[to] = town_builder[from]
  set town_build_type[to] = town_build_type[from]
  set town_build_wait[to] = town_build_wait[from]
  set town_build_item[to] = town_build_item[from]
  set town_build_count[to] = town_build_count[from]
  set town_build_progress[to] = town_build_progress[from]
  set town_build_distance[to] = town_build_distance[from]
  // Not below are temporary to keep usage of it accurate as army track will run after this and re-evaluate.
  if most_threatened_town == from then
    set most_threatened_town = to
  endif
  if most_threatened_enemy_town == from then
    set most_threatened_enemy_town = to
  endif
  if most_threatened_player_town == from then
    set most_threatened_player_town = to
  endif
  if home_town == from then
    set home_town = to
  endif
  if max_value_town == from then
    set max_value_town = to
  endif  
endfunction

function TrackTown takes integer num returns boolean
  local group g = CreateGroup()
  local unit u = null
  local location l = Location(0,0)
  local boolean found_expansion = false
  local boolean previously_had_expansion = town_has_expansion[num]
  
  set town_value[num] = 0
  set town_count[num] = 0
  set town_has_expansion[num] = false
  set town_can_tp[num] = false
  set town_dist[num] = -1
  if Player(town_owner[num]) == ai_player then
    if town_structures[num] == null then
      set town_structures[num] = CreateGroup()
    endif
    // Release dead handles from the previous snapshot before reusing the group.
    call DestroyGroup(g)
    set g = CopyGroup(town_structures[num])
    loop
      set u = FirstOfGroup(g)
      exitwhen u == null
      if not UnitAlive(u) or GetOwningPlayer(u) != ai_player then
        call FlushChildHashtable(tracked_structures, GetHandleId(u))
      endif
      call GroupRemoveUnit(g, u)
    endloop
    call DestroyGroup(g)
    set g = CreateGroup()
    call GroupClear(town_structures[num])
  endif
  call GroupEnumUnitsInRangeOfLoc(g, town_loc[num], town_radius, null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if UnitAlive(u) and GetUnitState(u, UNIT_STATE_LIFE) > 0 and GetOwningPlayer(u) == Player(town_owner[num]) and IsUnitType(u, UNIT_TYPE_STRUCTURE) and not IsUnitInGroup(u, in_town_group) and (GetOwningPlayer(u) != ai_player or num == town_num or GetTrackedStructureTown(u) == num) then
      call GroupAddUnit(in_town_group, u)
      if GetOwningPlayer(u) == ai_player then
        call GroupAddUnit(town_structures[num], u)
        call SaveInteger(tracked_structures, GetHandleId(u), 0, num + 1)
        call TrackedStructureDone(u)
      endif
      set l = GetSumLoc_dd(l, GetUnitLoc(u))
      set town_count[num] = town_count[num] + 1
      if IsUnitType(u, UNIT_TYPE_TOWNHALL) then
        set town_has_expansion[num] = true
        set town_can_tp[num] = true
        set town_value[num] = town_value[num] + 5
        set found_expansion = true
        call RemoveLocation(town_loc[num])
        set town_loc[num] = GetUnitLoc(u)
      elseif IsUnitGoldMine(u) then
        if GetUnitTypeId(u) == old_id[racial_expansion] then
          set town_has_expansion[num] = true
        endif
        set found_expansion = true
        // don't set town value for mine here as get near mine will do that
        call RemoveLocation(town_loc[num])
        set town_loc[num] = GetUnitLoc(u)
      else
        set town_value[num] = town_value[num] + 1
      endif  
    endif
    call GroupRemoveUnit(g, u)
  endloop
  call DestroyGroup(g)
  set g = null
  if previously_had_expansion and not town_has_expansion[num] and Player(town_owner[num]) == ai_player then
    set town_destroyed_time[num] = TimerGetElapsed(tq_timer)
  endif
  if town_count[num] == 0 then
    //call TraceAll("TOWNTRACK: ignoring town " + Int2Str(num) + " as no structures found")
    call RemoveLocation(l)
    set l = null
    return false
  endif
  if found_expansion then
    call RemoveLocation(l)
    set l = null
  else
    set l = GetDivisionLoc_d(l, Max(town_count[num], 1))
    call RemoveLocation(town_loc[num])
    set town_loc[num] = l
  endif  
//  if town_count[num] != 0 then
//    call PingMinimapEx(GetLocationX(l), GetLocationY(l), 9, 0, 0, 255, false)
//  endif
  set l = null
  // Calculate distance from home location and find nearby mine
  if home_location != null then
    set town_dist[num] = DistanceBetweenPoints(town_loc[num], home_location)
  endif  
  if town_mine[num] == null or not UnitAlive(town_mine[num]) then
    set town_mine[num] = GetMineNearLoc(town_mine[num], town_loc[num], 1500)
  endif
  if town_mine[num] != null then
    set town_value[num] = town_value[num] + 5
  endif  
  if (Player(town_owner[num]) == ai_player) then 
    call CreateDebugTagLoc("Tracked Town: " + Int2Str(num) + " structures:" + Int2Str(town_count[num]) + " dist:" + Int2Str(R2I(town_dist[num])), 16, GetLocationX(town_loc[num]), GetLocationY(town_loc[num]), 8.00, 3.00)
    if town_value[num] > max_value_town then
      set max_value_town = num
    endif
    if town_dist[num] <= town_radius then
      set home_town = num
      set home_found_temp = true
      //call TraceAll("TOWNTRACK: home_town=" + Int2Str(home_town) + " town_loc=(" + Real2Str(GetLocationX(town_loc[num])) + "," + Real2Str(GetLocationY(town_loc[num])) + ") count=" + Int2Str(town_count[num]))
    endif
  endif  
  return true
endfunction

function TrackExistingTowns takes nothing returns nothing
  local integer i = 0
  loop
    exitwhen i >= town_num
    call TrackTown(i)
    set i = i + 1
  endloop
endfunction

function SeedNewTownAtLoc takes location l, integer p returns nothing
  call ClearTownIntrusion(town_num)
  set town_defense_anchor[town_num] = null
  set town_owner[town_num] = p
  set town_loc[town_num] = l
  set town_threat[town_num] = 0
  if TrackTown(town_num) then
    set town_num = town_num + 1
    if (Player(p) == ai_player) then 
      set own_town[own_town_num] = town_num - 1
      set own_town_num = own_town_num + 1
     endif
  endif  
endfunction

function SeedNewTownsForPlayer takes integer p returns nothing
  local group g = CreateGroup()
  local unit u = null
  local location l = null
  call GroupEnumUnitsOfPlayer(g, Player(p), null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if (IsUnitType(u, UNIT_TYPE_TOWNHALL) or IsUnitGoldMine(u)) and UnitAlive(u) and not IsUnitInGroup(u, in_town_group) then
      call SeedNewTownAtLoc(GetUnitLoc(u), p)
    endif
    call GroupRemoveUnit(g, u)
  endloop
  call GroupClear(g)
  call GroupEnumUnitsOfPlayer(g, Player(p), null)
  loop
    set u = FirstOfGroup(g)
    exitwhen u == null
    if IsUnitType(u, UNIT_TYPE_STRUCTURE) and UnitAlive(u) and not IsUnitInGroup(u, in_town_group) then
      call SeedNewTownAtLoc(GetUnitLoc(u), p)
    endif
    call GroupRemoveUnit(g, u)
  endloop
  call DestroyGroup(g)
  set g = null
  set l = null
endfunction

function SeedNewTowns takes nothing returns nothing
  local integer p = 0
  loop
    exitwhen p >= GetBJMaxPlayers() or town_num >= JASS_MAX_ARRAY_SIZE
    if GetPlayerSlotState(Player(p)) == PLAYER_SLOT_STATE_PLAYING then
      call SeedNewTownsForPlayer(p)
    endif
    set p = p + 1
  endloop
  if not home_found_temp and max_value_town >= 0 then
    set home_town = max_value_town // most valuable town is likely the home town
  endif
endfunction

function TownTrackJob takes nothing returns nothing
    call DisplayToAllJobDebug("TOWN_TRACK Job Start")
    
  if not town_threatened then
    call GroupClear(in_town_group)
    set home_found_temp = false
    call TrackExistingTowns()
    call SeedNewTowns()
  endif
  
  //call TQAddJob(15, TOWN_TRACK, 0)
  call TQAddJob(1, ARMY_TRACK, 0) // Always runs army track after updating towns as otherwise most threatened town will not be correct
endfunction
#ENDIF
